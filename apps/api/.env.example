# Copy to apps/api/.env (gitignored) for local development.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (pnpm db:up). schema=public is required by Prisma.
DATABASE_URL=postgresql://cece:cece@localhost:5432/cece?schema=public

# Secret for signing JWTs. Use a long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me
