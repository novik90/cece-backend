// ce·ce schema.
// Phase 1 — Auth + Users + Matches: Obsidian `Контракты v1 — Auth, Users, Matches`.
// Phase 2 — real-time scoring (frames + event log): `Контракты v2 — Real-time скоринг`.
// Phase 3 — friends + match invites: `Контракты v3 — Друзья и приглашения`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  scheduled
  live
  completed
}

enum FrameStatus {
  in_progress
  completed
}

enum FriendshipStatus {
  pending
  accepted
}

enum MatchInviteStatus {
  pending
  accepted
  declined
  cancelled
  expired
}

model User {
  id           String   @id @default(uuid())
  handle       String   @unique
  displayName  String   @map("display_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedMatches   Match[]            @relation("MatchOwner")
  activeScoring  Match[]            @relation("ActiveScorer")
  participations MatchParticipant[]
  authoredEvents MatchEvent[]       @relation("EventAuthor")

  friendshipsRequested Friendship[]  @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]  @relation("FriendshipAddressee")
  invitesSent          MatchInvite[] @relation("InviteFrom")
  invitesReceived      MatchInvite[] @relation("InviteTo")

  @@map("users")
}

model Match {
  id                  String      @id @default(uuid())
  ownerId             String      @map("owner_id")
  bestOf              Int         @map("best_of")
  status              MatchStatus @default(scheduled)
  // Frames won per slot, aligned with match_participants.slot (0/1).
  framesWonA          Int         @default(0) @map("frames_won_a")
  framesWonB          Int         @default(0) @map("frames_won_b")
  // Winning participant referenced by slot (0/1); null until completed.
  winnerSlot          Int?        @map("winner_slot")
  // Phase 2 scoring settings.
  selfScoringDisabled Boolean     @default(false) @map("self_scoring_disabled")
  firstBreakerSlot    Int         @default(0) @map("first_breaker_slot")
  // Reserved/unused: Phase 2 uses a lock-free scoring model (no active scorer).
  activeScorerUserId  String?     @map("active_scorer_user_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  completedAt         DateTime?   @map("completed_at")

  owner        User               @relation("MatchOwner", fields: [ownerId], references: [id])
  activeScorer User?              @relation("ActiveScorer", fields: [activeScorerUserId], references: [id])
  participants MatchParticipant[]
  frames       Frame[]
  events       MatchEvent[]
  invites      MatchInvite[]

  @@index([ownerId])
  @@map("matches")
}

// Exactly two rows per match (slot 0 and 1): either a registered user or a guest.
model MatchParticipant {
  matchId   String  @map("match_id")
  slot      Int // 0 | 1
  userId    String? @map("user_id")
  guestName String? @map("guest_name")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@id([matchId, slot])
  @@index([userId])
  @@map("match_participants")
}

// One frame of a match. At most one `in_progress` per match (kept by the engine).
model Frame {
  id          String      @id @default(uuid())
  matchId     String      @map("match_id")
  frameNumber Int         @map("frame_number")
  breakerSlot Int         @map("breaker_slot")
  status      FrameStatus @default(in_progress)
  winnerSlot  Int?        @map("winner_slot")
  scoreA      Int         @default(0) @map("score_a")
  scoreB      Int         @default(0) @map("score_b")
  createdAt   DateTime    @default(now()) @map("created_at")
  completedAt DateTime?   @map("completed_at")

  match  Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  events MatchEvent[]

  @@unique([matchId, frameNumber])
  @@index([matchId])
  @@map("frames")
}

// Append-only scoring log; `seq` is monotonic per match. Source of truth that
// the live state is folded from; `undo` reverts the last event.
model MatchEvent {
  id        String   @id @default(uuid())
  matchId   String   @map("match_id")
  frameId   String?  @map("frame_id")
  seq       Int
  type      String
  payload   Json
  byUserId  String?  @map("by_user_id")
  createdAt DateTime @default(now()) @map("created_at")

  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  frame Frame? @relation(fields: [frameId], references: [id], onDelete: SetNull)
  by    User?  @relation("EventAuthor", fields: [byUserId], references: [id], onDelete: SetNull)

  @@unique([matchId, seq])
  @@index([matchId])
  @@index([frameId])
  @@map("match_events")
}

// Friend relationship. Friends = a row with status `accepted`, where the current
// user is either side. No expiry: a pending request lives until answered/cancelled.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@map("friendships")
}

// Match invitation. Accepting creates the match (carrying best_of / scoring opts).
// A pending invite expires 24h after creation; `expired` is computed lazily from
// `expires_at` on read/accept (no cron job).
model MatchInvite {
  id                  String            @id @default(uuid())
  fromUserId          String            @map("from_user_id")
  toUserId            String            @map("to_user_id")
  bestOf              Int               @map("best_of")
  selfScoringDisabled Boolean           @default(false) @map("self_scoring_disabled")
  firstBreakerSlot    Int               @default(0) @map("first_breaker_slot")
  status              MatchInviteStatus @default(pending)
  matchId             String?           @map("match_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  expiresAt           DateTime          @map("expires_at")
  respondedAt         DateTime?         @map("responded_at")

  from  User   @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to    User   @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([toUserId])
  @@index([fromUserId])
  @@map("match_invites")
}
