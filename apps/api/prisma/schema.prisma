// ce·ce — Phase 1 schema (Auth + Users + Matches, no real-time scoring).
// See Obsidian: cece app/cece-backend/Контракты v1 — Auth, Users, Matches.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  scheduled
  live
  completed
}

model User {
  id           String   @id @default(uuid())
  handle       String   @unique
  displayName  String   @map("display_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedMatches   Match[]            @relation("MatchOwner")
  activeScoring  Match[]            @relation("ActiveScorer")
  participations MatchParticipant[]

  @@map("users")
}

model Match {
  id                 String      @id @default(uuid())
  ownerId            String      @map("owner_id")
  bestOf             Int         @map("best_of")
  status             MatchStatus @default(scheduled)
  // Frames won per slot, aligned with match_participants.slot (0/1).
  framesWonA         Int         @default(0) @map("frames_won_a")
  framesWonB         Int         @default(0) @map("frames_won_b")
  // Winning participant referenced by slot (0/1); null until completed.
  winnerSlot         Int?        @map("winner_slot")
  // Phase 2: whose phone is currently entering the score.
  activeScorerUserId String?     @map("active_scorer_user_id")
  createdAt          DateTime    @default(now()) @map("created_at")
  completedAt        DateTime?   @map("completed_at")

  owner        User               @relation("MatchOwner", fields: [ownerId], references: [id])
  activeScorer User?              @relation("ActiveScorer", fields: [activeScorerUserId], references: [id])
  participants MatchParticipant[]

  @@index([ownerId])
  @@map("matches")
}

// Exactly two rows per match (slot 0 and 1): either a registered user or a guest.
model MatchParticipant {
  matchId   String  @map("match_id")
  slot      Int // 0 | 1
  userId    String? @map("user_id")
  guestName String? @map("guest_name")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@id([matchId, slot])
  @@index([userId])
  @@map("match_participants")
}
